rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function emailLower() {
      return request.auth.token.email.lower();
    }

    function me() {
      return request.auth != null && emailLower() == 'tony0930508440@gmail.com';
    }

    function couple() {
      return request.auth != null &&
        (emailLower() in ['tony0930508440@gmail.com', 'hbes10009@gmail.com']);
    }

    // 允許本人讀寫自己的進度，亦允許管理員讀寫任何人的資料（用於後台檢視、備份、還原與重設）
    match /userData/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || me() || couple());
    }

    // 每日問答（雙方皆可讀寫）
    match /daily/{day} {
      allow read, write: if couple() || me();
    }

    // 全站設定、加碼刮刮卡與默契問答設定
    match /coupleData/{doc} {
      allow read: if couple() || me();
      allow write: if me();
    }
  }
}
