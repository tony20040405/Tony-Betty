   rules_version = '2';
   service cloud.firestore {
     match /databases/{database}/documents {

       function me()     { return request.auth != null && request.auth.token.email == 'tony0930508440@gmail.com'; }
       function couple() { return request.auth != null &&
                           request.auth.token.email in ['tony0930508440@gmail.com', 'hbes10009@gmail.com']; }

       match /userData/{uid}   { allow read, write: if couple() && request.auth.uid == uid; }
       match /daily/{day}      { allow read, write: if couple(); }
       match /coupleData/{doc} { allow read: if couple(); allow write: if me(); }
     }
   }
